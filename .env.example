# =============================================================================
# Rental911 — Environment Variables
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and must NEVER be committed.
# =============================================================================

# ---- Supabase (Database + Auth) --------------------------------------------
# Project URL and anon key are safe to expose to the browser (NEXT_PUBLIC_*).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key bypasses RLS — SERVER ONLY. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- App --------------------------------------------------------------------
# Public base URL of the deployment (used for auth redirects, receipts, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Stripe (Phase 2 — rent collection + Connect Express) -------------------
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Connect webhook endpoint — rent payments (direct charges on landlords'
# connected accounts). See app/api/stripe/webhook.
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Platform fee applied to every rent payment (2.5%).
PLATFORM_FEE_PERCENT=2.5
# Separate, account-scoped (NOT Connect) webhook endpoint — vendor marketplace
# membership Checkout Sessions, platform-account charges with no connected
# account involved. See app/api/stripe/webhook-vendor-membership.
STRIPE_MEMBERSHIP_WEBHOOK_SECRET=whsec_xxx
# Separate, account-scoped (NOT Connect) webhook endpoint — landlord
# onboarding-fee Checkout Sessions + subscription status updates. See
# app/api/stripe/webhook-landlord-onboarding.
STRIPE_ONBOARDING_WEBHOOK_SECRET=whsec_xxx

# ---- Anthropic (maintenance chat summaries) ---------------------------------
ANTHROPIC_API_KEY=sk-ant-xxx
# Model used to summarize closed maintenance threads.
ANTHROPIC_SUMMARY_MODEL=claude-sonnet-4-6

# ---- GoHighLevel (CRM sync + Calendar) --------------------------------------
GHL_API_KEY=your-ghl-api-key
GHL_LOCATION_ID=your-ghl-location-id
# Public iframe embed URL for Christine's onboarding-call booking calendar (Step 9).
NEXT_PUBLIC_GHL_ONBOARDING_CALENDAR_EMBED=https://api.leadconnectorhq.com/widget/booking/your-calendar-id
# Hardcoded CRM link shown in the admin sidebar.
NEXT_PUBLIC_GHL_CRM_URL=https://app.gohighlevel.com
# Workflow to enroll a landlord's GHL contact in after their onboarding fee is
# paid (Step 8). Optional — enrollment silently no-ops if unset. Needs a real,
# current workflow id from the GHL dashboard; not guessed from old reference code.
GHL_ONBOARDING_WORKFLOW_ID=

# ---- LeaseRunner (tenant screening — Phase 5, placeholder) ------------------
LEASERUNNER_API_KEY=tbd
LEASERUNNER_API_BASE=https://api.leaserunner.com

# ---- Resend (transactional email — receipts, compliance + renewal alerts) --
RESEND_API_KEY=re_xxx
RECEIPT_FROM_EMAIL=receipts@rental911.net
ALERTS_FROM_EMAIL=alerts@rental911.net

# ---- Vercel Cron (Phase 4 — compliance + lease renewal checks) -------------
# Vercel sends this as `Authorization: Bearer $CRON_SECRET` automatically on
# scheduled invocations (see vercel.json). Required — the cron routes fail
# closed (401) if this is unset.
CRON_SECRET=your-cron-secret

# ---- AFC Home Club (warranty purchase + claim invoice automation) ---------
# Christine's real AFC realtor portal login — SERVER ONLY, never expose to
# the client, never log. See lib/afc.ts.
AFC_REALTOR_EMAIL=you@example.com
AFC_REALTOR_PASSWORD=changeme
# Manual login shortcut shown as an admin sidebar button (separate from the
# backend automation above).
NEXT_PUBLIC_AFC_HOME_CLUB_URL=https://afchomeclub.com/realtor/invoice
